---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import type { Locale } from '../lib/site';
import { alternatePath, SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
  home?: boolean;
  noFooter?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description[Astro.props.locale],
  locale,
  home = false,
  noFooter = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const pageTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const canonical = new URL(pathname, Astro.site);
const enPath = alternatePath(pathname, 'en');
const zhPath = alternatePath(pathname, 'zh');
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#030503" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline define:vars={{ home }}>
      try {
        if (home && sessionStorage.getItem('keng0nion.home.boot.v1') === '1') {
          document.documentElement.classList.add('skip-home-boot');
        }

        const cardMotion = window.matchMedia('(min-width: 768px) and (pointer: fine)').matches
          && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if ('IntersectionObserver' in window && cardMotion) {
          document.documentElement.classList.add('reveal-cards-enabled');
          window.setTimeout(() => {
            if (!document.documentElement.classList.contains('reveal-cards-initialized')) {
              document.documentElement.classList.remove('reveal-cards-enabled');
            }
          }, 1500);
        }

        const settingsKey = 'keng0nion-site-settings-v1';
        const settingsRaw = JSON.parse(localStorage.getItem(settingsKey) || '{}');
        const allowedQualities = ['low', 'balanced', 'high', 'ultra'];
        const quality = allowedQualities.includes(settingsRaw.quality) ? settingsRaw.quality : 'balanced';
        const feedbackColor = /^#[0-9a-f]{6}$/i.test(String(settingsRaw.feedbackColor || '')) ? settingsRaw.feedbackColor : '#9cff00';
        document.documentElement.dataset.visualQuality = quality;
        document.documentElement.dataset.feedback = settingsRaw.feedbackEnabled ? 'on' : 'off';
        document.documentElement.style.setProperty('--site-feedback-color', feedbackColor);

        const preferred = localStorage.getItem('keng0nion-locale');
        const path = window.location.pathname;
        const suffix = `${window.location.search}${window.location.hash}`;
        const isZh = path === '/zh/' || path.startsWith('/zh/');
        if (preferred === 'zh' && !isZh) {
          const target = path === '/' ? '/zh/' : `/zh${path}`;
          window.location.replace(`${target}${suffix}`);
        }
        if (preferred === 'en' && isZh) {
          const target = path.slice(3) || '/';
          window.location.replace(`${target}${suffix}`);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'en' ? 'Skip to content' : '跳至主要内容'}</a>
    <Header locale={locale} pathname={pathname} home={home} />
    <main id="main" class:list={[{ 'page-main': !home }]}>
      <slot />
    </main>
    {!noFooter && <Footer locale={locale} />}
    <script>
      let cardRevealObserver: IntersectionObserver | undefined;

      const revealCards = () => {
        cardRevealObserver?.disconnect();
        cardRevealObserver = undefined;

        const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal-card]'));
        if (!cards.length) return;

        const canAnimate = 'IntersectionObserver' in window
          && window.matchMedia('(min-width: 768px) and (pointer: fine)').matches
          && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!canAnimate) {
          cards.forEach((card) => card.classList.add('is-revealed'));
          return;
        }

        document.documentElement.classList.add('reveal-cards-enabled', 'reveal-cards-initialized');
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;

          const visible = cards
            .filter((card) => !card.classList.contains('is-revealed'))
            .filter((card) => {
              const rect = card.getBoundingClientRect();
              return rect.bottom > 0 && rect.top < window.innerHeight * .92;
            })
            .sort((a, b) => {
              const verticalOrder = a.getBoundingClientRect().top - b.getBoundingClientRect().top;
              if (Math.abs(verticalOrder) > 1) return verticalOrder;
              return Number(a.dataset.revealOrder ?? 0) - Number(b.dataset.revealOrder ?? 0);
            });

          visible.forEach((card, index) => {
            card.style.setProperty('--reveal-delay', `${index * 40}ms`);
            card.classList.add('is-revealed');
            observer.unobserve(card);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

        cardRevealObserver = observer;
        cards.forEach((card) => observer.observe(card));
      };

      const setupProjectClickFeedback = () => {
        const pathname = window.location.pathname;
        const enabledPath = pathname.includes('/projects/')
          || pathname.includes('/handheld-matrix/')
          || pathname.includes('/collatz-tree/');
        if (!enabledPath || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const canvas = document.createElement('canvas');
        canvas.className = 'site-click-feedback-canvas';
        canvas.setAttribute('aria-hidden', 'true');
        document.body.appendChild(canvas);
        const context = canvas.getContext('2d');
        if (!context) return;
        const glyphs = '01<>/{}[]#$%&*+-=アイウエオカキクケコ';
        const particles: Array<{x:number;y:number;vx:number;vy:number;life:number;maxLife:number;size:number;char:string;color:string}> = [];
        let width = 1;
        let height = 1;
        let dpr = 1;
        let frame = 0;
        let running = false;
        let last = performance.now();

        const settings = () => ({
          enabled: document.documentElement.dataset.feedback === 'on',
          color: getComputedStyle(document.documentElement).getPropertyValue('--site-feedback-color').trim() || '#9cff00',
        });
        const resize = () => {
          width = window.innerWidth;
          height = window.innerHeight;
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
          context.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        const draw = (time: number) => {
          if (!running) return;
          const delta = Math.min(0.034, Math.max(0.001, (time - last) / 1000));
          last = time;
          context.clearRect(0, 0, width, height);
          context.textAlign = 'center';
          context.textBaseline = 'middle';
          for (let index = particles.length - 1; index >= 0; index -= 1) {
            const particle = particles[index];
            particle.life -= delta;
            if (particle.life <= 0) {
              particles.splice(index, 1);
              continue;
            }
            particle.vy += 80 * delta;
            particle.vx *= Math.pow(.7, delta);
            particle.x += particle.vx * delta;
            particle.y += particle.vy * delta;
            const alpha = Math.min(1, particle.life / Math.min(.42, particle.maxLife));
            context.globalAlpha = alpha;
            context.fillStyle = particle.color;
            context.shadowColor = particle.color;
            context.shadowBlur = 10;
            context.font = `${particle.size}px var(--mono, monospace)`;
            context.fillText(particle.char, particle.x, particle.y);
          }
          context.globalAlpha = 1;
          context.shadowBlur = 0;
          if (particles.length > 0 && !document.hidden) frame = requestAnimationFrame(draw);
          else running = false;
        };
        const start = () => {
          if (running) return;
          running = true;
          last = performance.now();
          frame = requestAnimationFrame(draw);
        };
        const spawn = (event: PointerEvent) => {
          const current = settings();
          if (!current.enabled) return;
          const target = event.target;
          if (target instanceof Element && target.closest('.site-header, .site-footer, a, button, input, select, textarea, summary')) return;
          const count = window.matchMedia('(pointer: coarse)').matches ? 14 : 26;
          for (let index = 0; index < count; index += 1) {
            const angle = (Math.PI * 2 * index) / count + Math.random() * .45;
            const speed = 50 + Math.random() * 135;
            particles.push({
              x: event.clientX,
              y: event.clientY,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed - 18,
              life: .65 + Math.random() * .65,
              maxLife: 1.3,
              size: 8 + Math.random() * 9,
              char: glyphs[Math.floor(Math.random() * glyphs.length)] ?? '0',
              color: current.color,
            });
          }
          start();
        };
        resize();
        window.addEventListener('resize', resize, { passive: true });
        window.addEventListener('pointerdown', spawn, { passive: true });
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            running = false;
            cancelAnimationFrame(frame);
            context.clearRect(0, 0, width, height);
          }
        });
      };

      revealCards();
      setupProjectClickFeedback();
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) return;
        document.documentElement.classList.remove('reveal-cards-enabled');
        document.querySelectorAll<HTMLElement>('[data-reveal-card]').forEach((card) => {
          card.classList.remove('is-revealed');
          card.style.removeProperty('--reveal-delay');
        });
        window.requestAnimationFrame(revealCards);
      });
    </script>
  </body>
</html>
