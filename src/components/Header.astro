---
import type { Locale } from '../lib/site';
import { alternatePath, navLabels, pathFor, SITE } from '../lib/site';

interface Props {
  locale: Locale;
  pathname: string;
  home?: boolean;
}

const { locale, pathname, home = false } = Astro.props;
const labels = navLabels[locale];
const nav = [
  { label: labels.home, href: pathFor(locale), match: pathFor(locale) },
  { label: labels.projects, href: pathFor(locale, 'projects'), match: pathFor(locale, 'projects') },
  { label: labels.about, href: pathFor(locale, 'about'), match: pathFor(locale, 'about') },
  { label: labels.contact, href: pathFor(locale, 'contact'), match: pathFor(locale, 'contact') },
];
const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;
const isActive = (match: string) => match === pathFor(locale) ? normalized === match : normalized.startsWith(match);
const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const otherLabel = otherLocale === 'zh' ? '中文' : 'EN';
const settingsCopy = locale === 'en'
  ? {
      title: 'Settings',
      quality: 'Start-page Earth quality',
      qualityLow: 'Low · 1K',
      qualityBalanced: 'Balanced · 2K',
      qualityHigh: 'High · 4K',
      qualityUltra: 'Ultra · 8K',
      feedback: 'Project-page click feedback',
      color: 'Feedback color',
    }
  : {
      title: '设置',
      quality: '首页地球画质',
      qualityLow: '低 · 1K',
      qualityBalanced: '均衡 · 2K',
      qualityHigh: '高 · 4K',
      qualityUltra: '极高 · 8K',
      feedback: '项目页点击反馈',
      color: '反馈颜色',
    }; 
---
<header class:list={['site-header', { 'is-home': home }]} data-site-header>
  <div class="container header-inner">
    <a class="brand" href={pathFor(locale)} aria-label={SITE.title}>
      <span class="brand-mark" aria-hidden="true">K</span>
      <span class="brand-label">Keng0nion's Farm</span>
    </a>
    <div class="nav-shell">
      <nav class="site-nav" aria-label={locale === 'en' ? 'Primary navigation' : '主导航'}>
        {nav.map((item) => <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <a class="language-switch" href={alternatePath(normalized, otherLocale)} data-language-switch data-locale={otherLocale}>
        <span aria-hidden="true">//</span>{otherLabel}
      </a>
      <details class="site-settings" data-site-settings>
        <summary aria-label={settingsCopy.title} title={settingsCopy.title}>
          <svg class="settings-gear" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3.2v2.1M12 18.7v2.1M4.2 12h2.1M17.7 12h2.1M6.5 6.5 8 8M16 16l1.5 1.5M6.5 17.5 8 16M16 8l1.5-1.5" />
            <path d="M12 6.2a5.8 5.8 0 0 1 2 .35l1.05-1.45 2.1 1.2-.62 1.66a6 6 0 0 1 1.08 1.86l1.75.2v2.42l-1.75.2a6 6 0 0 1-1.08 1.86l.62 1.66-2.1 1.2L14 15.9a5.8 5.8 0 0 1-4 0l-1.05 1.45-2.1-1.2.62-1.66a6 6 0 0 1-1.08-1.86l-1.75-.2v-2.42l1.75-.2a6 6 0 0 1 1.08-1.86L6.85 6.3l2.1-1.2L10 6.55a5.8 5.8 0 0 1 2-.35Z" />
            <circle cx="12" cy="12" r="2.55" />
          </svg>
        </summary>
        <div class="settings-panel">
          <label>
            <span>{settingsCopy.quality}</span>
            <select data-setting-quality>
              <option value="low">{settingsCopy.qualityLow}</option>
              <option value="balanced">{settingsCopy.qualityBalanced}</option>
              <option value="high">{settingsCopy.qualityHigh}</option>
              <option value="ultra">{settingsCopy.qualityUltra}</option>
            </select>
          </label>
          <label class="settings-row">
            <span>{settingsCopy.feedback}</span>
            <input type="checkbox" data-setting-feedback />
          </label>
          <label>
            <span>{settingsCopy.color}</span>
            <input type="color" value="#9cff00" data-setting-color />
          </label>
          <div class="settings-colors" aria-label={settingsCopy.color}>
            <button type="button" data-color-preset="#9cff00" style="--preset-color: #9cff00" aria-label="lime"></button>
            <button type="button" data-color-preset="#45e8ff" style="--preset-color: #45e8ff" aria-label="cyan"></button>
            <button type="button" data-color-preset="#ae7bff" style="--preset-color: #ae7bff" aria-label="violet"></button>
            <button type="button" data-color-preset="#ffbf47" style="--preset-color: #ffbf47" aria-label="amber"></button>
            <button type="button" data-color-preset="#ff5c88" style="--preset-color: #ff5c88" aria-label="rose"></button>
          </div>
        </div>
      </details>
      <details class="mobile-nav">
        <summary>{locale === 'en' ? 'MENU' : '菜单'}</summary>
        <nav class="mobile-panel" aria-label={locale === 'en' ? 'Mobile navigation' : '移动端导航'}>
          {nav.map((item) => <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  const header = document.querySelector('[data-site-header]');
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  document.querySelectorAll('[data-language-switch]').forEach((link) => {
    link.addEventListener('click', () => {
      const locale = link.getAttribute('data-locale');
      if (locale) localStorage.setItem('keng0nion-locale', locale);
    });
  });

  (() => {
    type VisualQuality = 'low' | 'balanced' | 'high' | 'ultra';
    interface SiteSettings {
      quality: VisualQuality;
      feedbackEnabled: boolean;
      feedbackColor: string;
    }

    const key = 'keng0nion-site-settings-v1';
    const defaults: SiteSettings = {
      quality: 'balanced',
      feedbackEnabled: false,
      feedbackColor: '#9cff00',
    };
    const qualityOptions: ReadonlyArray<VisualQuality> = ['low', 'balanced', 'high', 'ultra'];
    const allowedQualities = new Set<VisualQuality>(qualityOptions);
    const normalizeColor = (value: unknown) => /^#[0-9a-f]{6}$/i.test(String(value ?? '')) ? String(value) : defaults.feedbackColor;
    const normalize = (value: unknown): SiteSettings => {
      const input = value && typeof value === 'object' ? value as Record<string, unknown> : {};
      return {
        quality: allowedQualities.has(input.quality as VisualQuality) ? input.quality as VisualQuality : defaults.quality,
        feedbackEnabled: Boolean(input.feedbackEnabled),
        feedbackColor: normalizeColor(input.feedbackColor),
      };
    };
    const read = (): SiteSettings => {
      try {
        return normalize(JSON.parse(localStorage.getItem(key) ?? '{}'));
      } catch {
        return { ...defaults };
      }
    };
    const apply = (settings: SiteSettings) => {
      document.documentElement.dataset.visualQuality = settings.quality;
      document.documentElement.dataset.feedback = settings.feedbackEnabled ? 'on' : 'off';
      document.documentElement.style.setProperty('--site-feedback-color', settings.feedbackColor);
      window.dispatchEvent(new CustomEvent('keng0nion:settings-change', { detail: settings }));
    };
    const write = (patch: Partial<SiteSettings>) => {
      const next = normalize({ ...read(), ...patch });
      localStorage.setItem(key, JSON.stringify(next));
      apply(next);
      return next;
    };

    const root = document.querySelector('[data-site-settings]');
    if (!root) return;
    const quality = root.querySelector<HTMLSelectElement>('[data-setting-quality]');
    const feedback = root.querySelector<HTMLInputElement>('[data-setting-feedback]');
    const color = root.querySelector<HTMLInputElement>('[data-setting-color]');
    const setForm = (settings: SiteSettings) => {
      if (quality) quality.value = settings.quality;
      if (feedback) feedback.checked = settings.feedbackEnabled;
      if (color) color.value = settings.feedbackColor;
    };

    const initial = read();
    setForm(initial);
    apply(initial);

    quality?.addEventListener('change', () => write({ quality: quality.value as VisualQuality }));
    feedback?.addEventListener('change', () => write({ feedbackEnabled: feedback.checked }));
    color?.addEventListener('input', () => write({ feedbackColor: color.value }));
    root.querySelectorAll('[data-color-preset]').forEach((button) => {
      button.addEventListener('click', () => {
        const preset = button.getAttribute('data-color-preset');
        if (!preset) return;
        if (color) color.value = preset;
        write({ feedbackColor: preset });
      });
    });
  })();
</script>
